<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>ClipBuffer.App</RootNamespace>
    <AssemblyName>ClipBuffer</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationTitle>Clip Buffer</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipBuffer.Core\ClipBuffer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\ffmpeg\ffmpeg.exe"
          Link="ffmpeg\ffmpeg.exe"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')" />
  </ItemGroup>

</Project>
