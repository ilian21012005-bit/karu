<Window x:Class="ClipBuffer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip Buffer"
        Width="980"
        Height="640"
        MinWidth="820"
        MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Clip Buffer"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText"
                       Text="Démarrage…"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <TabControl x:Name="RootTabs" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="{TemplateBinding Margin}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- CLIPS -->
            <TabItem Header="Clips">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <ComboBox x:Name="FilterBox"
                                  DockPanel.Dock="Top"
                                  Margin="0,0,0,8"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterBox_OnSelectionChanged">
                            <ComboBoxItem Content="Tous"/>
                            <ComboBoxItem Content="Manuel"/>
                            <ComboBoxItem Content="3 kills"/>
                            <ComboBoxItem Content="4 kills"/>
                            <ComboBoxItem Content="Ace"/>
                            <ComboBoxItem Content="Favoris"/>
                        </ComboBox>
                        <Button DockPanel.Dock="Bottom"
                                Content="Ouvrir le dossier"
                                Margin="0,8,0,0"
                                Click="OpenFolder_OnClick"/>
                        <ListBox x:Name="ClipList"
                                 Background="{StaticResource PanelBrush}"
                                 BorderBrush="#3C424C"
                                 Foreground="{StaticResource TextBrush}"
                                 SelectionChanged="ClipList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4">
                                        <Image Width="72" Height="40"
                                               Stretch="UniformToFill"
                                               Margin="0,0,8,0"
                                               Source="{Binding ThumbnailImage}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TagLabel}" Foreground="#9AA0A6" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Favori" Margin="0,0,8,0" Click="Favorite_OnClick"/>
                            <Button Content="Supprimer" Margin="0,0,8,0" Click="Delete_OnClick"/>
                            <ComboBox x:Name="TagBox" Width="120" SelectedIndex="0" SelectionChanged="TagBox_OnSelectionChanged">
                                <ComboBoxItem Content="Manuel"/>
                                <ComboBoxItem Content="3 kills"/>
                                <ComboBoxItem Content="4 kills"/>
                                <ComboBoxItem Content="Ace"/>
                            </ComboBox>
                        </StackPanel>
                        <Border Background="Black" CornerRadius="4">
                            <MediaElement x:Name="Player"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          Stretch="Uniform"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem Header="Réglages">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Replay"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Durée du replay" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DurationValueText"
                                       DockPanel.Dock="Right"
                                       Text="5 min"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="DurationSlider"
                                Minimum="15"
                                Maximum="600"
                                TickFrequency="15"
                                IsSnapToTickEnabled="True"
                                Value="300"
                                Margin="0,0,0,16"
                                ValueChanged="DurationSlider_OnValueChanged"/>

                        <TextBlock Text="Raccourci" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="HotkeyBox"
                                 IsReadOnly="True"
                                 Text="F9"
                                 PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                                 Margin="0,0,0,6"/>
                        <TextBlock Text="Clique dans la case puis appuie sur la combo."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Dossier des clips" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="FolderBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,8"/>
                        <Button Content="Choisir un dossier…"
                                HorizontalAlignment="Stretch"
                                Padding="12,8"
                                Click="BrowseButton_OnClick"
                                Margin="0,0,0,22"/>

                        <TextBlock Text="Highlights auto (killfeed OCR)"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Zone écran ~3×/s, pas d’overlay. Active seulement ce dont tu as besoin."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <CheckBox x:Name="HighlightsEnabledCheck"
                                  Content="Activer la détection killfeed"
                                  Margin="0,0,0,8"
                                  Checked="SettingsCheck_OnChanged"
                                  Unchecked="SettingsCheck_OnChanged"/>
                        <CheckBox x:Name="AutoTripleCheck"
                                  Content="Clip auto sur 3 kills"
                                  Margin="0,0,0,6"
                                  Checked="SettingsCheck_OnChanged"
                                  Unchecked="SettingsCheck_OnChanged"/>
                        <CheckBox x:Name="AutoQuadCheck"
                                  Content="Clip auto sur 4 kills"
                                  Margin="0,0,0,6"
                                  Checked="SettingsCheck_OnChanged"
                                  Unchecked="SettingsCheck_OnChanged"/>
                        <CheckBox x:Name="AutoAceCheck"
                                  Content="Clip auto sur Ace (5 kills)"
                                  Margin="0,0,0,12"
                                  Checked="SettingsCheck_OnChanged"
                                  Unchecked="SettingsCheck_OnChanged"/>

                        <TextBlock Text="Pseudo in-game (exact)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="PlayerNameBox"
                                 Margin="0,0,0,12"
                                 LostFocus="PlayerNameBox_OnLostFocus"/>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Cooldown entre clips auto" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CooldownValueText"
                                       DockPanel.Dock="Right"
                                       Text="15 s"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </DockPanel>
                        <Slider x:Name="CooldownSlider"
                                Minimum="5"
                                Maximum="60"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="15"
                                Margin="0,0,0,12"
                                ValueChanged="CooldownSlider_OnValueChanged"/>

                        <Button Content="Calibrer la zone killfeed…"
                                Padding="12,8"
                                Click="Calibrate_OnClick"
                                Margin="0,0,0,8"/>
                        <TextBlock x:Name="CalibrationInfo"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Lance Clip Buffer avant Valo. Plein écran fenêtré recommandé."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
