<Window x:Class="ClipBuffer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip Buffer"
        Width="460"
        Height="500"
        MinWidth="420"
        MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top"
                   Text="Clip Buffer"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top"
                   Text="Les N dernières minutes, sauvées au raccourci. Sans overlay."
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Démarrage…" Margin="0,16,0,8"/>
            <TextBlock Text="Lance-moi avant Valo. Plein écran fenêtré recommandé."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Durée du replay" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DurationValueText"
                               DockPanel.Dock="Right"
                               Text="5 min"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="DurationSlider"
                        Minimum="15"
                        Maximum="600"
                        TickFrequency="15"
                        IsSnapToTickEnabled="True"
                        Value="300"
                        Margin="0,0,0,18"
                        ValueChanged="DurationSlider_OnValueChanged"/>

                <TextBlock Text="Raccourci" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="HotkeyBox"
                         IsReadOnly="True"
                         Text="F9"
                         PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                         Margin="0,0,0,6"/>
                <TextBlock Text="Clique dans la case puis appuie sur la combo."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Dossier des clips" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="FolderBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"/>
                <Button x:Name="BrowseButton"
                        Content="Choisir un dossier…"
                        HorizontalAlignment="Stretch"
                        Padding="12,8"
                        Click="BrowseButton_OnClick"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
