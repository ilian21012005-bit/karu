<Window x:Class="Karu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WinForms;assembly=LibVLCSharp.WinForms"
        xmlns:local="clr-namespace:Karu.App"
        Title="Karu"
        Width="1280"
        Height="780"
        MinWidth="1024"
        MinHeight="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="pack://application:,,,/Assets/karu-logo.png"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="KARU" VerticalAlignment="Center" Margin="24,0,28,0"
                       FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17"/>
            <Button x:Name="NavClipsButton" Grid.Column="1" Style="{StaticResource NavButtonActive}"
                    Content="Clips" Click="NavClips_OnClick"/>
            <Button x:Name="NavSettingsButton" Grid.Column="2" Style="{StaticResource NavButton}"
                    Content="R&#233;glages" Click="NavSettings_OnClick"/>
            <StackPanel x:Name="StatusIndicator" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Ellipse x:Name="OcrHealthDot" Width="7" Height="7" Fill="#8A8A8A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="En attente de Valorant" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="5" Text="F9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <TextBlock x:Name="OcrHealthText" Visibility="Collapsed" Text="Killfeed : en attente"/>
        </Grid>
        <Grid Grid.Row="1">
            <!-- LIBRARY -->
            <Grid x:Name="ClipsView" Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock Text="CLIPS" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <ListBox x:Name="FilterBox"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectedIndex="0"
                             SelectionChanged="FilterBox_OnSelectionChanged"
                             VerticalAlignment="Center"
                             KeyboardNavigation.TabNavigation="Once">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,6"/>
                                <Setter Property="Margin" Value="0,0,18,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <StackPanel>
                                                <ContentPresenter x:Name="Content"
                                                                  TextElement.Foreground="{DynamicResource MutedBrush}"
                                                                  TextElement.FontFamily="{StaticResource DisplayFont}"
                                                                  TextElement.FontSize="13"
                                                                  HorizontalAlignment="Center"/>
                                                <Border x:Name="Underline"
                                                        Height="2"
                                                        Margin="2,5,2,0"
                                                        CornerRadius="1"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Content" Property="TextElement.FontWeight" Value="Bold"/>
                                                    <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="Tous"/>
                        <ListBoxItem Content="Favoris"/>
                        <ListBoxItem Content="Ace"/>
                        <ListBoxItem Content="4K"/>
                        <ListBoxItem Content="3K"/>
                        <ListBoxItem Content="Manuel"/>
                    </ListBox>
                </DockPanel>                <Border x:Name="PlayerNameBanner"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="{DynamicResource PanelBrush}"
                        Padding="10,4"
                        Margin="0,0,0,8">
                    <TextBlock Text="Le clip F9 marche sans pseudo. Pour les clips auto, ajoute ton pseudo exact dans Réglages → Highlights."
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="+ Dossier"
                                Style="{StaticResource IconButton}"
                                Click="NewFolder_OnClick"
                                Margin="0,0,6,0"
                                ToolTip="Nouveau dossier"/>
                        <Button Content="Explorer"
                                Style="{StaticResource IconButton}"
                                Click="OpenFolder_OnClick"
                                ToolTip="Ouvrir le dossier courant"/>
                    </StackPanel>
                    <ListBox x:Name="FolderList"
                             Height="44"
                             MinHeight="44"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             SelectionChanged="FolderList_OnSelectionChanged"
                             DragOver="FolderList_OnDragOver"
                             DragLeave="FolderList_OnDragLeave"
                             Drop="FolderList_OnDrop"
                             ToolTip="Glisse un clip ici pour le déplacer">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Nouveau dossier" Click="NewFolder_OnClick"/>
                                <MenuItem Header="Supprimer dossier" Click="DeleteFolder_OnClick"/>
                                <MenuItem Header="Ouvrir dans Explorer" Click="OpenFolder_OnClick"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource KaruFocusVisual}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chip"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="0"
                                                    Padding="6,7"
                                                    Cursor="Hand">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="{Binding NameWeight}"
                                           FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <TextBlock x:Name="FolderHintText"
                           Grid.Row="2"
                           VerticalAlignment="Bottom"
                           Margin="0,44,0,0"
                           Visibility="Collapsed"/>

                <!-- Hero + grille : un seul scroll (le hero part vers le haut) -->
                <ScrollViewer x:Name="LibraryScrollViewer"
                              Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <StackPanel>
                        <Grid x:Name="LibraryHero" Height="300" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="533"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ClipToBounds="True">
                                <Border Background="{DynamicResource VideoBgBrush}"/>
                                <StackPanel x:Name="HeroPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="KARU" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="APER&#199;U INDISPONIBLE" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <Image x:Name="HeroThumbnail" Stretch="UniformToFill" ClipToBounds="True"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,12,0">
                                <TextBlock Text="DERNIER CLIP" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontFamily="{StaticResource DisplayFont}"/>
                                <TextBlock x:Name="HeroTitle" Text="Tes clips appara&#238;tront ici" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <TextBlock x:Name="HeroMeta" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,0,20"/>
                                <Button x:Name="HeroPlayButton" Content="Ouvrir le clip" Style="{StaticResource AccentButton}" Width="140" HorizontalAlignment="Left" Click="HeroPlay_OnClick"/>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="ClipList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 PreviewMouseWheel="ClipList_OnPreviewMouseWheel"
                                 PreviewMouseMove="ClipList_OnPreviewMouseMove"
                                 PreviewMouseLeftButtonDown="ClipList_OnPreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="ClipList_OnPreviewMouseLeftButtonUp"
                                 PreviewMouseRightButtonDown="ClipList_OnPreviewMouseRightButtonDown"
                                 SelectionChanged="ClipList_OnSelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="ClipContextMenu_OnOpened">
                                    <MenuItem Header="Ouvrir" Click="OpenSelectedClip_OnClick"/>
                                    <MenuItem x:Name="MoveToMenu" Header="D&#233;placer vers"/>
                                    <Separator/>
                                    <MenuItem Header="Afficher dans Explorer" Click="RevealClip_OnClick"/>
                                    <MenuItem Header="Copier le chemin" Click="CopyPath_OnClick"/>
                                    <Separator/>
                                    <MenuItem Header="Supprimer" Click="Delete_OnClick" Foreground="{DynamicResource DangerBrush}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,14,16"/>
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource KaruFocusVisual}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="Card" Background="Transparent" BorderThickness="0"
                                                            Width="220" Cursor="Hand" SnapsToDevicePixels="True"/>
                                                    <ContentPresenter/>
                                                    <Border x:Name="SelectionMark" Height="2" Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                        <Setter TargetName="SelectionMark" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="220">
                                        <Border Height="124"
                                                Background="{DynamicResource VideoBgBrush}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="K" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Text="SANS APER&#199;U" FontSize="8" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                </StackPanel>
                                                <Image Stretch="UniformToFill" Source="{Binding ThumbnailImage}"/>
                                                <Border Background="{Binding TagBadgeBackground}"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="8">
                                                    <TextBlock Text="{Binding TagBadge}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               FontFamily="{StaticResource DisplayFont}"
                                                               Foreground="{Binding TagBadgeForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding AgeLabel}"
                                                           FontSize="10"
                                                           Padding="5,2"
                                                           Background="#99000000"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom"
                                                           Margin="8"
                                                           Foreground="White"/>
                                                <Button Style="{StaticResource GhostIconButton}"
                                                        Content="{Binding FavoriteGlyph}"
                                                        Foreground="{Binding FavoriteForeground}"
                                                        ToolTip="{Binding FavoriteToolTip}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="4"
                                                        Click="FavoriteStar_OnClick"
                                                        PreviewMouseLeftButtonDown="FavoriteStar_OnPreviewMouseLeftButtonDown"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="2,8,2,4">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding CardMeta}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="EmptyLibraryPanel"
                                Visibility="Collapsed"
                                Background="Transparent"
                                Padding="36,40"
                                HorizontalAlignment="Center"
                                MaxWidth="460">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Aucun clip pour l&#8217;instant"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,14"/>
                                <TextBlock Text="1. Entre ton pseudo Valorant (R&#233;glages)"
                                           FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="2. Lance Valorant &#8594; statut &#171; Buffer actif &#187;"
                                           FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="3. F9 pour un clip manuel, ou joue pour un Ace / 3K / 4K auto"
                                           FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- DETAIL CLIP -->
            <Grid x:Name="DetailView" Visibility="Collapsed" Margin="24,20,24,20" MouseMove="DetailView_OnMouseMove">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource IconButton}"
                            Click="BackToLibrary_OnClick"
                            Margin="0,0,14,0"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x2190;"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="Library"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="DetailIndexText"
                               DockPanel.Dock="Right"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Text="1 / 1"/>
                    <TextBlock x:Name="DetailTitle"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Border Background="{DynamicResource VideoBgBrush}"
                            ClipToBounds="True">
                        <WindowsFormsHost HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent">
                            <vlc:VideoView x:Name="PlayerView" Dock="Fill" BackColor="Black"/>
                        </WindowsFormsHost>
                    </Border>

                    <!-- Flèches type Photos Windows -->
                    <Button x:Name="PrevClipButton"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Width="48" Height="48"
                            FontSize="22"
                            Content="&#x2039;"
                            ToolTip="Clip pr&#233;c&#233;dent (&#x2190;)"
                            Click="PrevClip_OnClick"
                            Opacity="0.92">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="#99000000"
                                        CornerRadius="0"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="0,-3,2,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CC000000"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.25"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="NextClipButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Width="48" Height="48"
                            FontSize="22"
                            Content="&#x203A;"
                            ToolTip="Clip suivant (&#x2192;)"
                            Click="NextClip_OnClick"
                            Opacity="0.92">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="#99000000"
                                        CornerRadius="0"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="2,-3,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CC000000"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.25"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border x:Name="DetailControls" Grid.Row="1"
                        VerticalAlignment="Bottom"
                        Margin="0"
                        Background="#DD141416"
                        Padding="16,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeText"
                                       Text="0:00 / 0:00"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Slider x:Name="SeekSlider"
                                    Grid.Column="1"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp"
                                    ValueChanged="SeekSlider_OnValueChanged"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Groupe Lecture -->
                                <Button x:Name="PlayPauseButton"
                                        Style="{StaticResource IconButton}"
                                        Content="&#x23F8;"
                                        Click="PlayPause_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Lecture / Pause"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="-5s"
                                        Click="SeekBack_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Reculer 5 secondes"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="+5s"
                                        Click="SeekForward_OnClick"
                                        ToolTip="Avancer 5 secondes"/>

                                <!-- Séparateur visuel -->
                                <Border Width="1" Height="18"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center"/>

                                <!-- Groupe Trim -->
                                <Button Style="{StaticResource IconButton}"
                                        Content="D&#233;but"
                                        Click="TrimMarkIn_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Marquer le d&#233;but du trim"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="Fin"
                                        Click="TrimMarkOut_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Marquer la fin du trim"/>
                                <Button Style="{StaticResource AccentButton}"
                                        Content="Exporter"
                                        Click="TrimExport_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="R&#233;-exporter le segment (ffmpeg, hors jeu)"/>
                                <TextBlock x:Name="TrimRangeText"
                                           Text=""
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>

                                <!-- Séparateur visuel -->
                                <Border Width="1" Height="18"
                                        Background="{DynamicResource BorderBrush}"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center"/>

                                <!-- Groupe Actions Fichier -->
                                <Button Style="{StaticResource IconButton}"
                                        Content="Dossier"
                                        Click="RevealClip_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Afficher le fichier dans Explorer"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="Copier chemin"
                                        Click="CopyPath_OnClick"
                                        ToolTip="Copier le chemin du clip"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Vol"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Slider x:Name="VolumeSlider"
                                        Width="96"
                                        Height="22"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.8"
                                        SmallChange="0.05"
                                        LargeChange="0.1"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_OnValueChanged"/>
                                <TextBlock x:Name="VolumeText"
                                           Text="80%"
                                           Width="36"
                                           Margin="8,0,10,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="X"
                            Foreground="{DynamicResource MutedBrush}" ToolTip="Supprimer" Click="Delete_OnClick"/>
                    <TextBlock Text="TAG" Foreground="{DynamicResource MutedBrush}" FontSize="10"
                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="TagBox" Width="110" Height="28" SelectedIndex="0"
                              VerticalAlignment="Center" SelectionChanged="TagBox_OnSelectionChanged">
                        <ComboBoxItem Content="Manuel"/>
                        <ComboBoxItem Content="3 kills"/>
                        <ComboBoxItem Content="4 kills"/>
                        <ComboBoxItem Content="Ace"/>
                    </ComboBox>
                </DockPanel>
            </Grid>

            <!-- SETTINGS : 2 colonnes (moins de scroll) -->
            <Grid x:Name="SettingsView"
                  Visibility="Collapsed"
                  Margin="24,16,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="RÉGLAGES"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Capture à gauche · Highlights et app à droite."
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="13"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gauche -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CAPTURE"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Buffer, raccourci et dossier."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox x:Name="PauseOnBatteryCheck"
                                      Content="Suspendre le buffer sur batterie (laptop)"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <local:InfoHint Hint="Dès que le PC passe sur batterie, Karu arrête l’encodeur et la lecture du killfeed. Tout reprend au branchement. Sur un PC fixe branché, cette option ne fait rien."/>
                        </StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="DurationValueText"
                                       DockPanel.Dock="Right"
                                       Text="5 min"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Durée du replay" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <local:InfoHint Hint="Longueur du clip enregistré avec le raccourci. Karu ne conserve que ce laps de temps (15 secondes à 10 minutes) et efface le plus ancien au fur et à mesure. Allonger la durée grossit le dossier temporaire, pas la charge de l’encodeur. Les clips auto restent calés sur la série de kills, dans la limite de ce buffer."/>
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="DurationSlider"
                                Minimum="15"
                                Maximum="600"
                                TickFrequency="15"
                                IsSnapToTickEnabled="True"
                                Value="300"
                                Margin="0,0,0,14"
                                ValueChanged="DurationSlider_OnValueChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Raccourci" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <local:InfoHint Hint="Enregistre immédiatement le buffer en cours dans le dossier des clips. Le raccourci fonctionne dès que Valorant est lancé, y compris en alt-tab, et même si la détection killfeed est désactivée. Clique dans le champ, puis appuie sur la touche."/>
                        </StackPanel>
                        <TextBox x:Name="HotkeyBox"
                                 IsReadOnly="True"
                                 Text="F9"
                                 PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Clique puis appuie sur la touche."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Dossier des clips" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <local:InfoHint Hint="Dossier où les clips manuels et les clips auto sont enregistrés. Le buffer temporaire reste à part : ce dossier ne reçoit que les fichiers finaux."/>
                        </StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,22">
                            <Button DockPanel.Dock="Right"
                                    Content="Choisir…"
                                    MinWidth="100"
                                    Margin="10,0,0,0"
                                    Click="BrowseButton_OnClick"/>
                            <TextBox x:Name="FolderBox"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                     VerticalContentAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="CALIBRATION"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Zone où Karu lit le killfeed."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Calibrer la zone killfeed…"
                                    HorizontalAlignment="Left"
                                    MinWidth="220"
                                    VerticalAlignment="Center"
                                    Click="Calibrate_OnClick"/>
                            <local:InfoHint Hint="Trace le rectangle autour du killfeed, en haut à droite de Valorant. Karu ne lit que cette zone pour compter les kills. À refaire si tu changes de résolution ou si le killfeed a bougé. Le raccourci manuel n’en a pas besoin."/>
                        </StackPanel>
                        <TextBlock x:Name="CalibrationInfo"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Droite -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HIGHLIGHTS"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Clips auto killfeed."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="HighlightsEnabledCheck"
                                      Content="Activer la détection killfeed"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <local:InfoHint Hint="Autorise Karu à lire le killfeed, uniquement quand Valorant est la fenêtre active. Il faut un pseudo et au moins un palier (3, 4 ou Ace). Décoche pour ne garder que les clips au raccourci."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="AutoTripleCheck"
                                      Content="Clip auto sur 3 kills"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <local:InfoHint Hint="Enregistre un clip quand le killfeed a lu 3 de tes kills d’affilée. Le compteur repart à zéro si tu meurs, ou après environ 45 secondes sans kill. Le clip couvre la série : environ 10 s avant le premier kill et 10 s après le dernier. Si 4 kills ou Ace sont aussi cochés, un kill de plus avant la sauvegarde met à jour ce même clip."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="AutoQuadCheck"
                                      Content="Clip auto sur 4 kills"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <local:InfoHint Hint="Même principe à 4 kills. Si cette case est décochée, une série de 4 ne lance pas de clip. Un clip déjà préparé par les 3 kills n’est promu en 4 kills que si cette case est cochée."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <CheckBox x:Name="AutoAceCheck"
                                      Content="Clip auto sur Ace (5 kills)"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <local:InfoHint Hint="Même principe à 5 kills. Si seule cette case est cochée, Karu attend l’ace : 3 ou 4 kills ne créent pas de clip."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Pseudo in-game" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <local:InfoHint Hint="Le nom tel qu’il apparaît dans le killfeed, sans le #tag Riot s’il n’est pas affiché. La casse n’a pas d’importance. Karu ne compte un kill que si ce nom est le tueur. Vide : pas de clips auto. Le raccourci manuel n’en a pas besoin."/>
                        </StackPanel>
                        <TextBox x:Name="PlayerNameBox"
                                 Margin="0,0,0,14"
                                 LostFocus="PlayerNameBox_OnLostFocus"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="CooldownValueText"
                                       DockPanel.Dock="Right"
                                       Text="15 s"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Délai entre clips auto" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <local:InfoHint Hint="Après qu’un clip auto a été écrit, Karu ignore les nouveaux paliers pendant ce délai (5 à 60 s). Tant que le clip n’est pas encore écrit (environ 10 s après le dernier kill), un palier plus haut met à jour ce clip au lieu d’être bloqué."/>
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="CooldownSlider"
                                Minimum="5"
                                Maximum="60"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="15"
                                Margin="0,0,0,22"
                                ValueChanged="CooldownSlider_OnValueChanged"/>

                        <TextBlock Text="APPARENCE"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Palette."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <local:InfoHint Hint="Change seulement les couleurs de l’interface. La capture, les raccourcis et les clips ne bougent pas."/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,20"
                                  SelectionChanged="ThemeBox_OnSelectionChanged">
                            <ComboBoxItem Content="Riot (rouge et noir)" Tag="riot"/>
                            <ComboBoxItem Content="Carbon (bleu sombre)" Tag="carbon"/>
                            <ComboBoxItem Content="Aventurine (bordeaux)" Tag="aventurine"/>
                            <ComboBoxItem Content="Plum (violet)" Tag="plum"/>
                            <ComboBoxItem Content="Ember (terre)" Tag="ember"/>
                            <ComboBoxItem Content="Forest (vert)" Tag="forest"/>
                            <ComboBoxItem Content="Ocean (bleu)" Tag="ocean"/>
                            <ComboBoxItem Content="Holst (rose)" Tag="holst"/>
                            <ComboBoxItem Content="Crimson (rouge)" Tag="crimson"/>
                        </ComboBox>

                        <TextBlock Text="APPLICATION"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Démarrage et mises à jour."
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="StartWithWindowsCheck"
                                      Content="Démarrer Karu avec Windows"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <local:InfoHint Hint="Lance Karu à l’ouverture de ta session Windows, sans droits administrateur. Décoche pour le retirer du démarrage. Karu doit déjà tourner avant la partie, sinon le buffer est vide."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="CheckUpdatesCheck"
                                      Content="Vérifier les mises à jour au démarrage"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <local:InfoHint Hint="Au lancement, Karu regarde s’il existe une version plus récente et te prévient. Rien n’est installé tout seul. Le bouton en dessous fait la même vérification tout de suite."/>
                        </StackPanel>
                        <Button Content="Vérifier les mises à jour"
                                HorizontalAlignment="Left"
                                MinWidth="200"
                                Click="CheckUpdates_OnClick"
                                Margin="0,0,0,6"/>
                        <TextBlock x:Name="UpdateInfoText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="AppVersionText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Lance Karu avant Valorant. Plein écran fenêtré recommandé."
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
