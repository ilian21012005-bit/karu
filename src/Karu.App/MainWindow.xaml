<Window x:Class="Karu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Karu"
        Width="1280"
        Height="780"
        MinWidth="1024"
        MinHeight="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/karu-logo.png"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rail gauche type Medal -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Image DockPanel.Dock="Top"
                       Source="pack://application:,,,/Assets/karu-logo.png"
                       Width="28" Height="28"
                       Margin="0,18,0,16"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Button x:Name="NavSettingsButton"
                            Style="{StaticResource SideRailButton}"
                            Content="&#x2699;"
                            ToolTip="R&#233;glages"
                            Click="NavSettings_OnClick"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Top">
                    <Button x:Name="NavClipsButton"
                            Style="{StaticResource SideRailButtonActive}"
                            Content="&#x25A6;"
                            ToolTip="Library"
                            Click="NavClips_OnClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <!-- LIBRARY -->
            <Grid x:Name="ClipsView" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Library"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <Border Background="{DynamicResource PanelBrush}"
                                CornerRadius="10"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       Text="D&#233;marrage&#8230;"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <ComboBox x:Name="FilterBox"
                              DockPanel.Dock="Right"
                              Width="140"
                              Height="34"
                              SelectedIndex="0"
                              VerticalAlignment="Center"
                              SelectionChanged="FilterBox_OnSelectionChanged">
                        <ComboBoxItem Content="Tous"/>
                        <ComboBoxItem Content="Manuel"/>
                        <ComboBoxItem Content="3 kills"/>
                        <ComboBoxItem Content="4 kills"/>
                        <ComboBoxItem Content="Ace"/>
                        <ComboBoxItem Content="Favoris"/>
                    </ComboBox>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="+ Dossier"
                                Style="{StaticResource IconButton}"
                                Click="NewFolder_OnClick"
                                Margin="0,0,6,0"
                                ToolTip="Nouveau dossier"/>
                        <Button Content="Explorer"
                                Style="{StaticResource IconButton}"
                                Click="OpenFolder_OnClick"
                                ToolTip="Ouvrir le dossier courant"/>
                    </StackPanel>
                    <ListBox x:Name="FolderList"
                             Height="44"
                             MinHeight="44"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             SelectionChanged="FolderList_OnSelectionChanged"
                             DragOver="FolderList_OnDragOver"
                             DragLeave="FolderList_OnDragLeave"
                             Drop="FolderList_OnDrop"
                             ToolTip="Glisse un clip ici pour le déplacer">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Nouveau dossier" Click="NewFolder_OnClick"/>
                                <MenuItem Header="Supprimer dossier" Click="DeleteFolder_OnClick"/>
                                <MenuItem Header="Ouvrir dans Explorer" Click="OpenFolder_OnClick"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chip"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,6"
                                                    Cursor="Hand">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="{Binding NameWeight}"
                                           FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <TextBlock x:Name="FolderHintText"
                           Grid.Row="1"
                           VerticalAlignment="Bottom"
                           Margin="0,44,0,0"
                           Visibility="Collapsed"/>

                <!-- Grille de cartes -->
                <ListBox x:Name="ClipList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewMouseMove="ClipList_OnPreviewMouseMove"
                         PreviewMouseLeftButtonDown="ClipList_OnPreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="ClipList_OnPreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonDown="ClipList_OnPreviewMouseRightButtonDown"
                         SelectionChanged="ClipList_OnSelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="ClipContextMenu_OnOpened">
                            <MenuItem Header="Ouvrir"
                                      Click="OpenSelectedClip_OnClick"/>
                            <MenuItem x:Name="MoveToMenu" Header="Déplacer vers"/>
                            <Separator/>
                            <MenuItem Header="Afficher dans Explorer"
                                      Click="RevealClip_OnClick"/>
                            <MenuItem Header="Copier le chemin"
                                      Click="CopyPath_OnClick"/>
                            <Separator/>
                            <MenuItem Header="Supprimer"
                                      Click="Delete_OnClick"
                                      Foreground="{DynamicResource DangerBrush}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,14,14"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Width="260"
                                                Cursor="Hand"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Height="146"
                                        Background="{DynamicResource VideoBgBrush}"
                                        CornerRadius="12,12,0,0"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="&#x25B6;"
                                                   FontSize="28"
                                                   Opacity="0.28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding ThumbnailImage}"/>
                                        <Border Background="#99000000"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="8">
                                            <TextBlock Text="{Binding AgeLabel}"
                                                       FontSize="11"
                                                       Foreground="White"/>
                                        </Border>
                                        <Border Background="{DynamicResource BadgeBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8">
                                            <TextBlock Text="{Binding TagBadge}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding TagBadgeForeground}"/>
                                        </Border>
                                        <Button Style="{StaticResource GhostIconButton}"
                                                Content="{Binding FavoriteGlyph}"
                                                Foreground="{Binding FavoriteForeground}"
                                                ToolTip="{Binding FavoriteToolTip}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Click="FavoriteStar_OnClick"
                                                PreviewMouseLeftButtonDown="FavoriteStar_OnPreviewMouseLeftButtonDown"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="12,10,12,12">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13"/>
                                    <TextBlock Text="{Binding CardMeta}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- DETAIL CLIP -->
            <Grid x:Name="DetailView" Visibility="Collapsed" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left"
                            Content="&#x2190; Library"
                            Style="{StaticResource IconButton}"
                            Click="BackToLibrary_OnClick"
                            Margin="0,0,14,0"/>
                    <TextBlock x:Name="DetailIndexText"
                               DockPanel.Dock="Right"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Text="1 / 1"/>
                    <TextBlock x:Name="DetailTitle"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Border Background="{DynamicResource VideoBgBrush}"
                            CornerRadius="12"
                            ClipToBounds="True">
                        <MediaElement x:Name="Player"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      Volume="1"
                                      MediaOpened="Player_OnMediaOpened"
                                      MediaEnded="Player_OnMediaEnded"
                                      MediaFailed="Player_OnMediaFailed"/>
                    </Border>

                    <!-- Flèches type Photos Windows -->
                    <Button x:Name="PrevClipButton"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Width="48" Height="48"
                            FontSize="22"
                            Content="&#x2039;"
                            ToolTip="Clip précédent (←)"
                            Click="PrevClip_OnClick"
                            Opacity="0.92">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Background" Value="#99000000"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.25"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="NextClipButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Width="48" Height="48"
                            FontSize="22"
                            Content="&#x203A;"
                            ToolTip="Clip suivant (→)"
                            Click="NextClip_OnClick"
                            Opacity="0.92">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Background" Value="#99000000"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.25"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Background="{DynamicResource PanelBrush}"
                        CornerRadius="12"
                        Padding="16,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeText"
                                       Text="0:00 / 0:00"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Slider x:Name="SeekSlider"
                                    Grid.Column="1"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp"
                                    ValueChanged="SeekSlider_OnValueChanged"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PlayPauseButton"
                                        Style="{StaticResource IconButton}"
                                        Content="&#x23F8;"
                                        Click="PlayPause_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Lecture / Pause"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="-5s"
                                        Click="SeekBack_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Reculer 5 secondes"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="+5s"
                                        Click="SeekForward_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Avancer 5 secondes"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="Dossier"
                                        Click="RevealClip_OnClick"
                                        Margin="0,0,6,0"
                                        ToolTip="Afficher le fichier dans Explorer"/>
                                <Button Style="{StaticResource IconButton}"
                                        Content="Copier chemin"
                                        Click="CopyPath_OnClick"
                                        ToolTip="Copier le chemin du clip"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Vol"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Slider x:Name="VolumeSlider"
                                        Width="96"
                                        Height="22"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.8"
                                        SmallChange="0.05"
                                        LargeChange="0.1"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_OnValueChanged"/>
                                <TextBlock x:Name="VolumeText"
                                           Text="80%"
                                           Width="36"
                                           Margin="8,0,10,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"/>
                                <ComboBox x:Name="TagBox"
                                          Width="100"
                                          SelectedIndex="0"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          SelectionChanged="TagBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Manuel"/>
                                    <ComboBoxItem Content="3 kills"/>
                                    <ComboBoxItem Content="4 kills"/>
                                    <ComboBoxItem Content="Ace"/>
                                </ComboBox>
                                <Button Style="{StaticResource GhostIconButton}"
                                        Content="X"
                                        Foreground="{DynamicResource DangerBrush}"
                                        ToolTip="Supprimer"
                                        Click="Delete_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SETTINGS (inchangé fonctionnellement) -->
            <ScrollViewer x:Name="SettingsView"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Margin="20,16,20,16">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="APPARENCE"/>
                            <TextBlock Text="Th&#232;me"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ThemeBox"
                                      SelectedIndex="0"
                                      SelectionChanged="ThemeBox_OnSelectionChanged">
                                <ComboBoxItem Content="Carbon (bleu sombre)" Tag="carbon"/>
                                <ComboBoxItem Content="Aventurine (bordeaux)" Tag="aventurine"/>
                                <ComboBoxItem Content="Plum (violet)" Tag="plum"/>
                                <ComboBoxItem Content="Ember (terre)" Tag="ember"/>
                                <ComboBoxItem Content="Forest (vert)" Tag="forest"/>
                                <ComboBoxItem Content="Ocean (bleu)" Tag="ocean"/>
                                <ComboBoxItem Content="Holst (rose)" Tag="holst"/>
                                <ComboBoxItem Content="Crimson (rouge)" Tag="crimson"/>
                            </ComboBox>
                            <TextBlock Text="Palette sombre — change l&#8217;ambiance de toute l&#8217;app."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,8,0,12"
                                       TextWrapping="Wrap"/>
                            <CheckBox x:Name="StartWithWindowsCheck"
                                      Content="D&#233;marrer Karu avec Windows"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SYSTEME"/>
                            <CheckBox x:Name="PauseOnBatteryCheck"
                                      Content="Suspendre le buffer sur batterie (laptop)"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="CheckUpdatesCheck"
                                      Content="V&#233;rifier les mises &#224; jour au d&#233;marrage"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <Button Content="V&#233;rifier les mises &#224; jour maintenant"
                                    Margin="0,8,0,6"
                                    HorizontalAlignment="Stretch"
                                    Click="CheckUpdates_OnClick"/>
                            <TextBlock x:Name="UpdateInfoText"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text=""/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="REPLAY"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Dur&#233;e du replay" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DurationValueText"
                                           DockPanel.Dock="Right"
                                           Text="5 min"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="DurationSlider"
                                    Minimum="15"
                                    Maximum="600"
                                    TickFrequency="15"
                                    IsSnapToTickEnabled="True"
                                    Value="300"
                                    Margin="0,0,0,18"
                                    ValueChanged="DurationSlider_OnValueChanged"/>

                            <TextBlock Text="Raccourci" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="HotkeyBox"
                                     IsReadOnly="True"
                                     Text="F9"
                                     PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                                     Margin="0,0,0,6"/>
                            <TextBlock Text="Clique dans la case puis appuie sur la combo."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="Dossier des clips" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="FolderBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,8"/>
                            <Button Content="Choisir un dossier..."
                                    HorizontalAlignment="Stretch"
                                    Click="BrowseButton_OnClick"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="HIGHLIGHTS AUTO"/>
                            <TextBlock Text="Zone &#233;cran ~3&#215;/s, pas d&#8217;overlay. Active seulement ce dont tu as besoin."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <CheckBox x:Name="HighlightsEnabledCheck"
                                      Content="Activer la d&#233;tection killfeed"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="AutoTripleCheck"
                                      Content="Clip auto sur 3 kills"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="AutoQuadCheck"
                                      Content="Clip auto sur 4 kills"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="AutoAceCheck"
                                      Content="Clip auto sur Ace (5 kills)"
                                      Margin="0,0,0,14"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>

                            <TextBlock Text="Pseudo in-game (exact)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="PlayerNameBox"
                                     Margin="0,0,0,14"
                                     LostFocus="PlayerNameBox_OnLostFocus"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Cooldown entre clips auto" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CooldownValueText"
                                           DockPanel.Dock="Right"
                                           Text="15 s"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </DockPanel>
                            <Slider x:Name="CooldownSlider"
                                    Minimum="5"
                                    Maximum="60"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="15"
                                    Margin="0,0,0,14"
                                    ValueChanged="CooldownSlider_OnValueChanged"/>

                            <Button Content="Calibrer la zone killfeed..."
                                    Click="Calibrate_OnClick"
                                    Margin="0,0,0,8"/>
                            <TextBlock x:Name="CalibrationInfo"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Lance Karu avant Valo. Plein &#233;cran fen&#234;tr&#233; recommand&#233;."
                               Foreground="{DynamicResource MutedBrush}"
