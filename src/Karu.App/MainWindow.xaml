<Window x:Class="Karu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Karu"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/karu-logo.png">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/karu-logo.png"
                       Width="26" Height="26"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Karu"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"/>
                <Button x:Name="NavClipsButton"
                        Style="{StaticResource NavButtonActive}"
                        Content="Clips"
                        Click="NavClips_OnClick"
                        Margin="0,0,4,0"/>
                <Button x:Name="NavSettingsButton"
                        Style="{StaticResource NavButton}"
                        Content="R&#233;glages"
                        Click="NavSettings_OnClick"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="{DynamicResource PanelBrush}"
                    CornerRadius="10"
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="D&#233;marrage&#8230;"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"/>
            </Border>
        </DockPanel>

        <Grid>
            <Grid x:Name="ClipsView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Dossiers"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource GhostIconButton}"
                                Content="+"
                                ToolTip="Nouveau dossier"
                                Click="NewFolder_OnClick"
                                HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock x:Name="FolderHintText"
                               DockPanel.Dock="Bottom"
                               Text="Glisse un clip vers un dossier"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                    <ListBox x:Name="FolderList"
                             Background="{DynamicResource PanelBrush}"
                             AllowDrop="True"
                             SelectionChanged="FolderList_OnSelectionChanged"
                             DragOver="FolderList_OnDragOver"
                             DragLeave="FolderList_OnDragLeave"
                             Drop="FolderList_OnDrop">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Nouveau dossier" Click="NewFolder_OnClick"/>
                                <MenuItem Header="Supprimer dossier" Click="DeleteFolder_OnClick"/>
                                <MenuItem Header="Ouvrir dans Explorer" Click="OpenFolder_OnClick"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=">"
                                               FontSize="11"
                                               Margin="0,0,8,0"
                                               Opacity="0.55"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="{Binding NameWeight}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <ComboBox x:Name="FilterBox"
                              DockPanel.Dock="Top"
                              Margin="0,0,0,10"
                              Height="32"
                              SelectedIndex="0"
                              SelectionChanged="FilterBox_OnSelectionChanged">
                        <ComboBoxItem Content="Tous"/>
                        <ComboBoxItem Content="Manuel"/>
                        <ComboBoxItem Content="3 kills"/>
                        <ComboBoxItem Content="4 kills"/>
                        <ComboBoxItem Content="Ace"/>
                        <ComboBoxItem Content="Favoris"/>
                    </ComboBox>
                    <ListBox x:Name="ClipList"
                             Background="{DynamicResource PanelBrush}"
                             PreviewMouseMove="ClipList_OnPreviewMouseMove"
                             PreviewMouseLeftButtonDown="ClipList_OnPreviewMouseLeftButtonDown"
                             SelectionChanged="ClipList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="120" Height="68"
                                            CornerRadius="6"
                                            Background="{DynamicResource VideoBgBrush}"
                                            ClipToBounds="True"
                                            Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="&#x25B6;"
                                                       FontSize="18"
                                                       Opacity="0.35"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding ThumbnailImage}"/>
                                            <Border Background="{DynamicResource BadgeBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Margin="5">
                                                <TextBlock Text="{Binding TagBadge}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding TagBadgeForeground}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource GhostIconButton}"
                                            Content="{Binding FavoriteGlyph}"
                                            Foreground="{Binding FavoriteForeground}"
                                            ToolTip="{Binding FavoriteToolTip}"
                                            VerticalAlignment="Center"
                                            Click="FavoriteStar_OnClick"
                                            PreviewMouseLeftButtonDown="FavoriteStar_OnPreviewMouseLeftButtonDown"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Border Grid.Column="4"
                        Background="{DynamicResource PanelBrush}"
                        CornerRadius="12"
                        Padding="10">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom"
                                Margin="0,10,0,0"
                                Padding="4,2,4,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TimeText"
                                               Text="0:00 / 0:00"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <Slider x:Name="SeekSlider"
                                            Grid.Column="1"
                                            Height="22"
                                            VerticalAlignment="Center"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="0"
                                            IsMoveToPointEnabled="True"
                                            PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp"
                                            ValueChanged="SeekSlider_OnValueChanged"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PlayPauseButton"
                                                Style="{StaticResource IconButton}"
                                                Content="&#x23F8;"
                                                Click="PlayPause_OnClick"
                                                Margin="0,0,6,0"
                                                ToolTip="Lecture / Pause"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Content="-5s"
                                                Click="SeekBack_OnClick"
                                                Margin="0,0,6,0"
                                                ToolTip="Reculer 5 secondes"/>
                                        <Button Style="{StaticResource IconButton}"
                                                Content="+5s"
                                                Click="SeekForward_OnClick"
                                                ToolTip="Avancer 5 secondes"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Vol"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Slider x:Name="VolumeSlider"
                                                Width="96"
                                                Height="22"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="0.8"
                                                SmallChange="0.05"
                                                LargeChange="0.1"
                                                VerticalAlignment="Center"
                                                ValueChanged="VolumeSlider_OnValueChanged"/>
                                        <TextBlock x:Name="VolumeText"
                                                   Text="80%"
                                                   Width="36"
                                                   Margin="8,0,10,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"/>
                                        <ComboBox x:Name="TagBox"
                                                  Width="100"
                                                  SelectedIndex="0"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="TagBox_OnSelectionChanged">
                                            <ComboBoxItem Content="Manuel"/>
                                            <ComboBoxItem Content="3 kills"/>
                                            <ComboBoxItem Content="4 kills"/>
                                            <ComboBoxItem Content="Ace"/>
                                        </ComboBox>
                                        <Button Style="{StaticResource GhostIconButton}"
                                                Content="X"
                                                Foreground="{DynamicResource DangerBrush}"
                                                ToolTip="Supprimer"
                                                Click="Delete_OnClick"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource VideoBgBrush}"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <MediaElement x:Name="Player"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          Volume="1"
                                          MediaOpened="Player_OnMediaOpened"
                                          MediaEnded="Player_OnMediaEnded"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <ScrollViewer x:Name="SettingsView"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="APPARENCE"/>
                            <TextBlock Text="Th&#232;me"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ThemeBox"
                                      SelectedIndex="0"
                                      SelectionChanged="ThemeBox_OnSelectionChanged">
                                <ComboBoxItem Content="Carbon (bleu sombre)"/>
                                <ComboBoxItem Content="Aventurine (bordeaux)"/>
                            </ComboBox>
                            <TextBlock Text="Carbon = th&#232;me actuel. Aventurine = rouge bordeaux m&#233;tallique."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,8,0,12"
                                       TextWrapping="Wrap"/>
                            <CheckBox x:Name="StartWithWindowsCheck"
                                      Content="D&#233;marrer Karu avec Windows"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="SYSTEME"/>
                            <CheckBox x:Name="PauseOnBatteryCheck"
                                      Content="Suspendre le buffer sur batterie (laptop)"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="CheckUpdatesCheck"
                                      Content="V&#233;rifier les mises &#224; jour au d&#233;marrage"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <Button Content="V&#233;rifier les mises &#224; jour maintenant"
                                    Margin="0,8,0,6"
                                    HorizontalAlignment="Stretch"
                                    Click="CheckUpdates_OnClick"/>
                            <TextBlock x:Name="UpdateInfoText"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text=""/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="REPLAY"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Dur&#233;e du replay" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DurationValueText"
                                           DockPanel.Dock="Right"
                                           Text="5 min"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider x:Name="DurationSlider"
                                    Minimum="15"
                                    Maximum="600"
                                    TickFrequency="15"
                                    IsSnapToTickEnabled="True"
                                    Value="300"
                                    Margin="0,0,0,18"
                                    ValueChanged="DurationSlider_OnValueChanged"/>

                            <TextBlock Text="Raccourci" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="HotkeyBox"
                                     IsReadOnly="True"
                                     Text="F9"
                                     PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                                     Margin="0,0,0,6"/>
                            <TextBlock Text="Clique dans la case puis appuie sur la combo."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="Dossier des clips" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="FolderBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,8"/>
                            <Button Content="Choisir un dossier..."
                                    HorizontalAlignment="Stretch"
                                    Click="BrowseButton_OnClick"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            Padding="22"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="HIGHLIGHTS AUTO"/>
                            <TextBlock Text="Zone &#233;cran ~3&#215;/s, pas d&#8217;overlay. Active seulement ce dont tu as besoin."
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <CheckBox x:Name="HighlightsEnabledCheck"
                                      Content="Activer la d&#233;tection killfeed"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="AutoTripleCheck"
                                      Content="Clip auto sur 3 kills"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="AutoQuadCheck"
                                      Content="Clip auto sur 4 kills"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>
                            <CheckBox x:Name="AutoAceCheck"
                                      Content="Clip auto sur Ace (5 kills)"
                                      Margin="0,0,0,14"
                                      Checked="SettingsCheck_OnChanged"
                                      Unchecked="SettingsCheck_OnChanged"/>

                            <TextBlock Text="Pseudo in-game (exact)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="PlayerNameBox"
                                     Margin="0,0,0,14"
                                     LostFocus="PlayerNameBox_OnLostFocus"/>

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Cooldown entre clips auto" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CooldownValueText"
                                           DockPanel.Dock="Right"
                                           Text="15 s"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </DockPanel>
                            <Slider x:Name="CooldownSlider"
                                    Minimum="5"
                                    Maximum="60"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="15"
                                    Margin="0,0,0,14"
                                    ValueChanged="CooldownSlider_OnValueChanged"/>

                            <Button Content="Calibrer la zone killfeed..."
                                    Click="Calibrate_OnClick"
                                    Margin="0,0,0,8"/>
                            <TextBlock x:Name="CalibrationInfo"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Lance Karu avant Valo. Plein &#233;cran fen&#234;tr&#233; recommand&#233;."
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="4,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
